<title>Mocha & Milk 💗 Birthday Surprise</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:"Trebuchet MS", Arial, sans-serif;
    background:#3b0b1b;
    color:#fff5ec;
    overflow-x:hidden;
}

/* =========================
   COLORS
========================= */

:root{
    --maroon:#3b0b1b;
    --dark-maroon:#240611;
    --wine:#64152b;
    --pink:#d98b9b;
    --light-pink:#f1c3cc;
    --cream:#fff1df;
    --gold:#d8ad62;
    --soft-gold:#f0d49b;
}

/* =========================
   DECORATIONS
========================= */

.decor{
    position:fixed;
    pointer-events:none;
    z-index:1;
    opacity:.8;
}

.decor.one{
    top:35px;
    left:25px;
    font-size:35px;
}

.decor.two{
    top:70px;
    right:30px;
    font-size:30px;
}

.decor.three{
    bottom:40px;
    left:25px;
    font-size:28px;
}

.decor.four{
    bottom:60px;
    right:25px;
    font-size:35px;
}

.sparkle{
    position:fixed;
    pointer-events:none;
    color:var(--soft-gold);
    animation:twinkle 2s infinite ease-in-out;
    z-index:2;
}

.s1{top:18%;left:8%;font-size:22px;}
.s2{top:28%;right:10%;font-size:18px;animation-delay:.5s;}
.s3{top:55%;left:5%;font-size:17px;animation-delay:1s;}
.s4{top:72%;right:7%;font-size:25px;animation-delay:1.5s;}
.s5{top:12%;left:50%;font-size:16px;animation-delay:.8s;}

@keyframes twinkle{
    0%,100%{
        opacity:.3;
        transform:scale(.8) rotate(0);
    }
    50%{
        opacity:1;
        transform:scale(1.3) rotate(20deg);
    }
}

/* =========================
   FLOATING HEARTS
========================= */

.heart{
    position:fixed;
    bottom:-30px;
    z-index:3;
    pointer-events:none;
    animation:floatHeart 7s linear forwards;
}

@keyframes floatHeart{
    0%{
        transform:translateY(0) scale(.7);
        opacity:0;
    }
    15%{
        opacity:.9;
    }
    100%{
        transform:translateY(-110vh) rotate(360deg) scale(1.2);
        opacity:0;
    }
}

/* =========================
   COMMON
========================= */

section{
    position:relative;
    min-height:100vh;
    padding:70px 20px;
    overflow:hidden;
}

.section-inner{
    max-width:1100px;
    margin:auto;
    position:relative;
    z-index:5;
}

.gold-line{
    width:100px;
    height:3px;
    background:var(--gold);
    margin:15px auto 25px;
    border-radius:50px;
}

/* =========================
   FIRST PAGE
========================= */

.hero{
    background:
        radial-gradient(circle at 10% 20%, #741d3825 0 90px, transparent 91px),
        radial-gradient(circle at 90% 80%, #d8ad6215 0 120px, transparent 121px),
        linear-gradient(145deg,#240611,#4c0d22,#300816);
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
}

.hero::before{
    content:"";
    position:absolute;
    inset:18px;
    border:1px solid #d8ad6244;
    border-radius:30px;
    pointer-events:none;
}

.top-decoration{
    font-size:25px;
    letter-spacing:12px;
    color:var(--soft-gold);
    margin-bottom:20px;
    animation:softFloat 3s infinite ease-in-out;
}

@keyframes softFloat{
    50%{
        transform:translateY(-5px);
    }
}

.small-title{
    color:var(--light-pink);
    font-size:18px;
    letter-spacing:2px;
    margin-bottom:10px;
}

.hero h1{
    font-family:Georgia,serif;
    font-size:clamp(50px,9vw,100px);
    line-height:1;
    color:var(--cream);
    text-shadow:
        0 0 10px #d8ad6255,
        4px 4px 0 #64152b;
}

.hero h1 span{
    color:var(--light-pink);
}

.hero-subtitle{
    font-size:22px;
    color:var(--soft-gold);
    margin:20px auto;
    max-width:650px;
}

/* =========================
   TEDDY AREA
========================= */

.bear-stage{
    display:flex;
    justify-content:center;
    align-items:flex-end;
    gap:80px;
    margin:35px auto;
    max-width:750px;
}

.bear-card{
    width:230px;
    position:relative;
    animation:bearsFloat 3s infinite ease-in-out;
}

.bear-card:nth-child(2){
    animation-delay:.7s;
}

@keyframes bearsFloat{
    0%,100%{
        transform:translateY(0);
    }
    50%{
        transform:translateY(-12px);
    }
}

/*
   Teddy placeholders.
   You can replace the emoji with your own
   realistic teddy images later.
*/

.bear-image{
    width:190px;
    height:190px;
    margin:auto;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:115px;
    background:radial-gradient(circle,#fff4e5,#d9a87d);
    border:4px solid #d8ad6288;
    box-shadow:
        0 15px 35px #00000055,
        inset 0 0 25px #ffffff55;
}

.milk .bear-image{
    background:radial-gradient(circle,#ffffff,#e9e3dc);
}

.bear-name{
    margin-top:15px;
    font-family:Georgia,serif;
    font-size:28px;
    color:var(--soft-gold);
}

.bear-label{
    font-size:14px;
    color:#f4ccd3;
    margin-top:5px;
}

/* =========================
   BUTTONS
========================= */

.button-row{
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
    margin-top:25px;
}

.btn{
    border:none;
    padding:14px 28px;
    border-radius:50px;
    font-size:17px;
    font-weight:bold;
    cursor:pointer;
    transition:.3s;
}

.btn:hover{
    transform:translateY(-4px) scale(1.04);
}

.primary{
    background:var(--gold);
    color:#32101b;
    box-shadow:0 8px 25px #d8ad6244;
}

.secondary{
    background:#ffffff14;
    color:white;
    border:1px solid #d8ad6288;
}

/* =========================
   MUSIC
========================= */

.music-box{
    margin:35px auto 0;
    max-width:420px;
    padding:15px 20px;
    border:1px solid #d8ad6255;
    border-radius:20px;
    background:#ffffff0d;
    backdrop-filter:blur(10px);
}

.music-title{
    color:var(--soft-gold);
    margin-bottom:10px;
}

.music-bars{
    display:flex;
    justify-content:center;
    align-items:flex-end;
    gap:5px;
    height:30px;
    margin-bottom:10px;
}

.music-bars span{
    width:5px;
    background:var(--pink);
    border-radius:10px;
    height:10px;
}

.music-bars.playing span{
    animation:bars .7s infinite alternate;
}

.music-bars span:nth-child(2){animation-delay:.1s;}
.music-bars span:nth-child(3){animation-delay:.2s;}
.music-bars span:nth-child(4){animation-delay:.3s;}
.music-bars span:nth-child(5){animation-delay:.4s;}

@keyframes bars{
    to{
        height:28px;
    }
}

/* =========================
   SURPRISE
========================= */

.surprise{
    background:
        radial-gradient(circle at 20% 30%,#8c284b33,transparent 150px),
        linear-gradient(145deg,#4a0d22,#65162f,#3b0b1b);
    text-align:center;
    display:flex;
    align-items:center;
    justify-content:center;
}

.surprise h2,
.memories h2,
.letter-section h2{
    font-family:Georgia,serif;
    font-size:clamp(38px,6vw,65px);
    color:var(--cream);
}

.surprise-text{
    font-size:20px;
    color:#f5ccd4;
    margin:15px auto 30px;
}

/* =========================
   GIFT BOX
========================= */

.gift-wrap{
    width:220px;
    height:190px;
    margin:30px auto;
    position:relative;
    cursor:pointer;
}

.gift-box{
    position:absolute;
    bottom:0;
    left:20px;
    width:180px;
    height:120px;
    background:linear-gradient(145deg,#9f294a,#64152b);
    border-radius:8px;
    box-shadow:0 20px 35px #00000055;
}

.gift-box::after{
    content:"";
    position:absolute;
    left:78px;
    top:0;
    width:25px;
    height:120px;
    background:var(--gold);
}

.gift-lid{
    position:absolute;
    left:10px;
    top:40px;
    width:200px;
    height:35px;
    border-radius:8px;
    background:linear-gradient(145deg,#c34e6d,#7b1835);
    z-index:3;
    transition:1s;
}

.gift-lid::after{
    content:"";
    position:absolute;
    left:87px;
    width:25px;
    height:35px;
    background:var(--gold);
}

.bow-left,
.bow-right{
    position:absolute;
    top:10px;
    width:55px;
    height:38px;
    border:8px solid var(--gold);
    border-radius:50%;
    z-index:4;
}

.bow-left{
    left:60px;
    transform:rotate(-25deg);
}

.bow-right{
    right:60px;
    transform:rotate(25deg);
}

.gift-wrap.open .gift-lid{
    transform:translateY(-80px) rotate(-8deg);
}

/* =========================
   MEMORIES
========================= */

.memories{
    background:#fff1df;
    color:#4a1324;
    text-align:center;
