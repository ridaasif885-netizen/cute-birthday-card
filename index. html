/* =========================
   FOOTER
========================= */

footer{
    background:#21050e;
    color:#d8ad62;
    text-align:center;
    padding:25px;
}

/* =========================
   MOBILE
========================= */

@media(max-width:700px){

    section{
        padding:55px 15px;
