    margin:auto;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.memory-card{
    background:white;
    padding:12px;
    border-radius:18px;
    box-shadow:0 12px 30px #64152b18;
    transition:.4s;
}

.memory-card:hover{
    transform:translateY(-10px) rotate(-1deg);
}

.memory-photo{
    height:230px;
    border-radius:12px;
    background:
        linear-gradient(135deg,#d98b9b,#64152b);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:50px;
    color:white;
    overflow:hidden;
}

.memory-photo img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.memory-card h3{
    margin:14px 5px 5px;
    color:#64152b;
}

.memory-card p{
    color:#80606a;
    font-size:14px;
    padding-bottom:8px;
}

/* =========================
   LETTER
========================= */

.letter-section{
    background:
        radial-gradient(circle at 90% 10%,#d8ad6222,transparent 180px),
        linear-gradient(145deg,#280714,#521126,#350817);
    text-align:center;
}

.envelope{
    width:min(90vw,600px);
    height:400px;
    margin:45px auto 20px;
    position:relative;
    cursor:pointer;
    perspective:1000px;
}

.envelope-body{
    position:absolute;
    inset:0;
    background:#fff1df;
    border-radius:15px;
    box-shadow:0 25px 50px #00000055;
    z-index:1;
}

.letter-paper{
    position:absolute;
    width:88%;
    left:6%;
    top:35px;
    min-height:320px;
    background:#fffdf7;
    color:#5a2938;
    padding:28px;
    border-radius:10px;
    z-index:2;
    transition:1s;
    text-align:left;
    box-shadow:0 8px 20px #00000022;
}

.letter-paper h3{
    color:#8b1f3c;
    font-family:Georgia,serif;
    font-size:26px;
    margin-bottom:15px;
    text-align:center;
}

.letter-paper p{
    line-height:1.7;
    font-size:15px;
}

.flap{
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:55%;
    background:#f2c9bc;
    clip-path:polygon(0 0,100% 0,50% 100%);
    transform-origin:top;
    transition:1s;
    z-index:4;
}

.envelope.open .flap{
    transform:rotateX(180deg);
}

.envelope.open .letter-paper{
    transform:translateY(-100px);
}

/* =========================
   FINAL
========================= */

.final{
    min-height:70vh;
    background:#fff1df;
    color:#4b1325;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
}

.final h2{
    font-family:Georgia,serif;
    color:#64152b;
    font-size:clamp(40px,7vw,70px);
}

.final p{
    max-width:650px;
    margin:20px auto;
    line-height:1.8;
    color:#74515d;
}

.final-heart{
    font-size:70px;
    animation:heartbeat 1.3s infinite;
}

@keyframes heartbeat{
    50%{
        transform:scale(1.2);
    }
