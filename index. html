        font-size:80px;
    }

    .bear-name{
        font-size:22px;
    }

    .memory-grid{
        grid-template-columns:1fr;
        max-width:380px;
    }

    .memory-photo{
        height:260px;
    }

    .envelope{
        height:430px;
    }

    .letter-paper{
        min-height:350px;
    }
}
</style>
</head>

