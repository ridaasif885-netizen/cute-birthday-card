<script>

/* =========================
   BIRTHDAY MELODY
========================= */

let audioContext;
let playing = false;
let melodyTimer;

const notes = [
    261.63,
    261.63,
    293.66,
    261.63,
    349.23,
    329.63,

    261.63,
    261.63,
    293.66,
    261.63,
    392.00,
    349.23,

    261.63,
    261.63,
    523.25,
    440.00,
    349.23,
    329.63,
    293.66,

    466.16,
    466.16,
    440.00,
    349.23,
    392.00,
    349.23
];

let noteIndex = 0;

function playNote(){

    if(!playing) return;

    if(!audioContext){
        audioContext = new (
            window.AudioContext ||
            window.webkitAudioContext
        )();
    }

    const oscillator =
        audioContext.createOscillator();

    const gain =
        audioContext.createGain();

    oscillator.frequency.value =
        notes[noteIndex];

    oscillator.type = "sine";

    gain.gain.setValueAtTime(
        0.0001,
        audioContext.currentTime
    );

    gain.gain.exponentialRampToValueAtTime(
        0.12,
        audioContext.currentTime + .03
    );

    gain.gain.exponentialRampToValueAtTime(
        0.0001,
        audioContext.currentTime + .45
    );

    oscillator.connect(gain);
    gain.connect(audioContext.destination);

    oscillator.start();

    oscillator.stop(
        audioContext.currentTime + .5
    );

    noteIndex++;

    if(noteIndex >= notes.length){
        noteIndex = 0;
    }

    melodyTimer =
        setTimeout(playNote,520);
}


function toggleMusic(){

    const button =
        document.getElementById("musicButton");

    const bars =
        document.getElementById("musicBars");

    if(!playing){

        playing = true;

        button.innerHTML =
            "⏸ Pause Birthday Melody";

        bars.classList.add("playing");

        playNote();

    }else{

        playing = false;

        clearTimeout(melodyTimer);

        button.innerHTML =
            "▶ Play Birthday Melody";

        bars.classList.remove("playing");
    }
}


